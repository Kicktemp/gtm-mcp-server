# Copy to .env (never commit .env). Only this value is required:
# Bearer key for the MCP endpoint, at least 32 bytes: openssl rand -hex 32
SERVICE_ACCOUNT_API_KEY=

# Optional overrides (defaults are set in docker-compose.yml)
# LOG_LEVEL=info
# Comma-separated container public IDs, or * for all, empty = nothing allowed
# KT_ALLOWED_CONTAINERS=GTM-XXXXXXX
